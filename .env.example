# Base de datos
POSTGRES_USER=smoothflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smoothflow
DATABASE_URL=postgresql://smoothflow:changeme@localhost:5432/smoothflow

# API
API_PORT=3000
NODE_ENV=development
# El seed demo corre automático solo en desarrollo (NODE_ENV != production).
# Manual: pnpm --filter @smoothflow/api seed
SESSION_SECRET=dev-session-secret-change-in-production
ENCRYPTION_KEY=dev-only-change-in-production-32b
WEB_ORIGIN=http://localhost:5173

# Web (solo desarrollo local con pnpm dev; en Docker prod el frontend usa /api relativo)
VITE_API_URL=http://localhost:3000

# --- Producción (VPS: ~/smoothflow/.env) ---
# DATABASE_URL=postgresql://smoothflow:TU_PASSWORD_SEGURO@postgres:5432/smoothflow
# NODE_ENV=production
# SESSION_SECRET=genera-un-secreto-largo-aleatorio
# ENCRYPTION_KEY=exactamente-32-caracteres-aqui!!
# WEB_ORIGIN=https://smoothflow.sebasinmas.site

# Deploy (solo producción — configurar en GitHub Secrets)
# VPS_HOST=
# VPS_USER=
# VPS_SSH_KEY=
# GHCR_TOKEN=   # PAT con read:packages para pull en la VPS

# Imágenes GHCR (solo docker-compose.prod.yml en la VPS)
# GHCR_OWNER=tu-usuario-github
# IMAGE_TAG=latest
